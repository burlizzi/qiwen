{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "make",
            "type": "shell",
            "command": "make",
             "options": {
                "cwd": "${workspaceFolder}/platform",
                "env": {
                   "PATH": "${env:PATH}:${workspaceFolder}/.devcontainer/arm-anykav200-crosstool/usr/bin",
                   "LD_LIBRARY_PATH": "${env:LD_LIBRARY_PATH}:${workspaceFolder}/.devcontainer/arm-anykav200-crosstool/usr/lib"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher":"$gcc",
        }
    ]
}